{
  "attribution": { "commit": "", "pr": "" },
  "permissions": {
    "deny": [
      "Read(./worker/.dev.vars)",
      "Read(./worker/.dev-data.sql)",
      "Read(./worker/.dev-backfill.sql)",
      "Read(./backfill-nw.sql)",
      "Read(./fix-fx-rates.sql)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bootstrap.js\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-push.js\""
          }
        ]
      }
    ]
  }
}
